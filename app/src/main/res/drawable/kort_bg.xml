<?xml version="1.0" encoding="utf-8"?>
<!-- Tydelig fokusmarkering: lys kant og lysere flate når kortet har fokus (D-pad) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E66FF" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#9CC2FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A4FCC" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B2234" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#2C3650" />
        </shape>
    </item>
</selector>
